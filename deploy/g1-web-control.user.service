[Unit]
Description=UniRoboGui G1 Web control and perception workstation (user)
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/unitree/UniRoboGui
Environment=HOME=/home/unitree
Environment=CMAKE_PREFIX_PATH=/home/unitree/.local/unitree_robotics
Environment=LD_LIBRARY_PATH=/home/unitree/.local/unitree_robotics/lib:/usr/local/lib:/opt/ros/noetic/lib/aarch64-linux-gnu
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do ip link show dev eth0 >/dev/null 2>&1 && ip -4 addr show dev eth0 | grep -q "inet " && exit 0; sleep 1; done; echo "eth0 did not become ready within 30s" >&2; exit 1'
ExecStart=/home/unitree/UniRoboGui/build/g1_web_server --interface eth0 --bind 0.0.0.0 --port 8080 --publish-hz 10 --web-root /home/unitree/UniRoboGui/web --enable-navigation
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGINT

[Install]
WantedBy=default.target
