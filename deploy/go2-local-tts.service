[Unit]
Description=UniRoboGui GO2 local Kokoro TTS service
After=network.target

[Service]
User=unitree
Group=unitree
Type=simple
WorkingDirectory=/home/unitree/UniRoboGui
Environment=HOME=/home/unitree
ExecStart=/home/unitree/UniRoboGui/tts_kokoro/bin/python /home/unitree/UniRoboGui/scripts/kokoro_tts_server.py --bind 127.0.0.1 --port 8765 --model-dir /home/unitree/UniRoboGui/tts_models/kokoro-multi-lang-v1_1 --sid 3 --speed 1.2 --threads 8
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
