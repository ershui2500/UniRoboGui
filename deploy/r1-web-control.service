[Unit]
Description=UniRoboGui R1 Web control and perception workstation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unitree
Group=unitree
WorkingDirectory=/home/unitree/UniRoboGui
Environment=HOME=/home/unitree
Environment=CMAKE_PREFIX_PATH=/usr/local
Environment=LD_LIBRARY_PATH=/usr/local/lib
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do ip link show dev eth10 >/dev/null 2>&1 && ip -4 addr show dev eth10 | grep -q "inet " && exit 0; sleep 1; done; echo "eth10 did not become ready within 30s" >&2; exit 1'
ExecStart=/home/unitree/UniRoboGui/build/g1_web_server --interface eth10 --bind 0.0.0.0 --port 8080 --publish-hz 10 --web-root /home/unitree/UniRoboGui/web --robot r1
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
